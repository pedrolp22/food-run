# Embed editable GLSL at configure time. Shader edits automatically trigger regeneration.
function(subway_embed_shaders output_directory)
    file(GLOB shader_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${shader_files})
    set(contents "#pragma once\n#include <string_view>\nnamespace engine::graphics::shaders {\n")
    foreach(shader IN LISTS shader_files)
        get_filename_component(name "${shader}" NAME)
        string(REPLACE "." "_" name "${name}")
        file(READ "${shader}" source)
        string(APPEND contents "inline constexpr std::string_view ${name} = R\"GLSL(${source})GLSL\";\n")
    endforeach()
    string(APPEND contents "}\n")
    file(MAKE_DIRECTORY "${output_directory}")
    file(CONFIGURE OUTPUT "${output_directory}/ShaderSources.h" CONTENT "${contents}" @ONLY)
endfunction()
